# ==========================================
# 1. LLM Provider & Active Model
# ==========================================
# Supported providers: groq, openai, ollama
MODEL_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
MODEL_TEMPERATURE=0.7

# API Keys (Provide the key matching your MODEL_PROVIDER)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=

# Optional Web Search Keys (Defaults to GitHub raw scraper + DuckDuckGo + HackerNews)
TAVILY_API_KEY=

# ==========================================
# 2. PostgreSQL Database & Connection Pool
# ==========================================
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_db
# Optional full async connection string override:
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/blog_db

# ==========================================
# 3. Observability & Tracing (LangSmith - Optional)
# ==========================================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autonomous-blog-engine

# ==========================================
# 4. Server Configuration & CORS
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# 5. Granular Per-Node Overrides (Optional)
# ==========================================
# RESEARCH_TEMPERATURE=0.1
# RESEARCH_MAX_TOKENS=512
# TITLE_TEMPERATURE=0.65
# TITLE_MAX_TOKENS=150
# WRITER_TEMPERATURE=0.4
# WRITER_MAX_TOKENS=4096
# VERIFIER_TEMPERATURE=0.0
# VERIFIER_MAX_TOKENS=1024
# TRANSLATOR_TEMPERATURE=0.2
# TRANSLATOR_MAX_TOKENS=4096
